      "html": "<div class=\"ds-stop\"><span class=\"ds-stop-num\">1</span><div class=\"ds-stop-main\"><div class=\"ds-stop-title\">Renegade Wizard +3</div><div class=\"ds-stop-sub\">Medium · Lv 11 · Southwest</div></div><div class=\"ds-stop-xp\">+192<small>Lv 1 · 192 xp</small></div></div>",
      "css": ".ds-stop{display:flex;align-items:flex-start;gap:10px;padding:10px 14px;border-top:1px solid var(--w-edge,#2C3440);color:var(--w-ink,#EEF1F4);transition:background 120ms ease-out}.ds-stop:hover{background:var(--w-wash,#1B222C)}.ds-stop-num{flex:none;width:28px;height:28px;display:grid;place-items:center;border-radius:50%;background:var(--w-accent,#FFD43B);color:var(--w-on-accent,#11151B);font-family:'Chakra Petch',system-ui,sans-serif;font-weight:700;font-size:14px}.ds-stop-main{flex:1}.ds-stop-title{font-family:'Hanken Grotesk',system-ui,sans-serif;font-weight:800;font-size:15px;line-height:1.3}.ds-stop-sub{font-family:'Hanken Grotesk',system-ui,sans-serif;font-size:13px;font-weight:700;color:var(--w-muted,#9AA4B2)}.ds-stop-xp{text-align:right;font-family:'Chakra Petch',system-ui,sans-serif;font-size:15px;font-weight:700;font-variant-numeric:tabular-nums}.ds-stop-xp small{display:block;font-size:12px;color:var(--w-muted,#9AA4B2)}"
