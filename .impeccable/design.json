  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one yellow action on a surface.",
      "html": "<button class=\"ds-btn-primary\">Preview</button>",
      "css": ".ds-btn-primary{background:var(--w-accent,#FFD43B);color:var(--w-on-accent,#11151B);border:1px solid var(--w-accent,#FFD43B);border-radius:6px;padding:0 14px;height:34px;font-family:'Chakra Petch',system-ui,sans-serif;font-weight:600;font-size:13px;letter-spacing:.02em;cursor:pointer;transition:transform 80ms ease-out,background-color 120ms ease-out}.ds-btn-primary:hover{background:#FCC419}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:3px solid var(--w-sky,#74C0FC);outline-offset:2px}"
    },
    {
      "name": "Default Button",
      "kind": "button",
      "refersTo": "button-default",
      "description": "Secondary HUD control.",
      "html": "<button class=\"ds-btn-default\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 14l-4 -4l4 -4\"/><path d=\"M5 10h11a4 4 0 1 1 0 8h-1\"/></svg>Undo</button>",
      "css": ".ds-btn-default{display:inline-flex;align-items:center;gap:6px;background:var(--w-wash,#1B222C);color:var(--w-ink,#EEF1F4);border:1px solid var(--w-edge,#2C3440);border-radius:6px;padding:0 12px;height:34px;font-family:'Chakra Petch',system-ui,sans-serif;font-weight:600;font-size:13px;letter-spacing:.02em;cursor:pointer;transition:transform 80ms ease-out,border-color 120ms ease-out}.ds-btn-default:hover{border-color:var(--w-faint,#6B7686)}.ds-btn-default:active{transform:translateY(1px)}.ds-btn-default:focus-visible{outline:3px solid var(--w-sky,#74C0FC);outline-offset:2px}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Context chip in the HUD bar.",
      "html": "<a class=\"ds-chip\" href=\"#\">Scrimmage v1.1</a> <span class=\"ds-chip\">Night Elf vs Orc</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:5px;background:var(--w-wash,#1B222C);color:var(--w-ink,#EEF1F4);font-family:'Chakra Petch',system-ui,sans-serif;font-size:12px;font-weight:600;text-decoration:none;white-space:nowrap}a.ds-chip{color:var(--w-sky,#74C0FC)}a.ds-chip:hover{filter:brightness(1.15)}a.ds-chip:focus-visible{outline:3px solid var(--w-sky,#74C0FC);outline-offset:2px}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Field with its caption label.",
      "html": "<label class=\"ds-field\"><span>Description</span><input class=\"ds-input\" placeholder=\"Wizard first, then loop west\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px}.ds-field span{font-family:'Chakra Petch',system-ui,sans-serif;font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--w-muted,#9AA4B2)}.ds-input{height:36px;padding:0 12px;border:1px solid var(--w-edge,#2C3440);border-radius:6px;background:var(--w-paper,#0C1015);color:var(--w-ink,#EEF1F4);font-family:'Hanken Grotesk',system-ui,sans-serif;font-weight:600;font-size:14px}.ds-input::placeholder{color:var(--w-disabled,#6B7686)}.ds-input:focus{border-color:var(--w-sky,#74C0FC);outline:none}"
    },
    {
      "name": "HUD Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Floating panel with a colour tab before the title.",
      "html": "<section class=\"ds-win\"><div class=\"ds-win-bar\"><span class=\"ds-win-title\">Route</span><span class=\"ds-win-right\">4 stops</span></div><div class=\"ds-win-body\">Stops go here.</div></section>",
      "css": ".ds-win{background:var(--w-panel,rgba(10,13,18,.94));border:1px solid var(--w-edge,#2C3440);border-radius:8px;box-shadow:0 8px 24px var(--w-shadow-c,rgba(0,0,0,.5));overflow:hidden;color:var(--w-ink,#EEF1F4)}.ds-win-bar{display:flex;align-items:center;gap:10px;min-height:44px;padding:6px 14px;font-family:'Chakra Petch',system-ui,sans-serif;font-size:15px;font-weight:600;letter-spacing:.02em}.ds-win-bar::before{content:'';width:4px;height:16px;border-radius:2px;background:var(--w-accent,#FFD43B)}.ds-win-title{flex:1}.ds-win-right{font-family:'Hanken Grotesk',system-ui,sans-serif;font-size:13px;font-weight:700;color:var(--w-muted,#9AA4B2)}.ds-win-body{border-top:1px solid var(--w-edge,#2C3440);padding:12px 14px;font-family:'Hanken Grotesk',system-ui,sans-serif;font-size:15px}"
    },
    {
      "name": "Hero Level Bar",
      "kind": "custom",
      "refersTo": "xp-bar",
      "description": "Level number and current-level XP progress.",
      "html": "<div class=\"ds-level\"><b>Lv 3</b><div class=\"ds-track\"><div class=\"ds-fill\" style=\"width:42%\"></div></div><small>167 / 400 XP to level 4</small></div>",
      "css": ".ds-level{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:4px 14px;padding:12px 14px}.ds-level b{font-family:'Chakra Petch',system-ui,sans-serif;font-weight:700;font-size:26px;line-height:1;color:var(--w-xp,#9B5CF6)}.ds-track{height:10px;border-radius:5px;background:var(--w-xp-track,#241A35);overflow:hidden}.ds-fill{height:100%;border-radius:5px;background:var(--w-xp,#9B5CF6);transition:width 400ms cubic-bezier(.22,1,.36,1)}.ds-level small{grid-column:2;font-family:'Hanken Grotesk',system-ui,sans-serif;font-weight:700;font-size:13px;color:var(--w-muted,#9AA4B2);font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Stop Numbers",
      "kind": "custom",
      "refersTo": "stop-number",
      "description": "Cleared, skipped, level-up and waypoint states.",
      "html": "<div class=\"ds-nums\"><span class=\"ds-num\">1</span><span class=\"ds-num\" data-state=\"partial\">2</span><span class=\"ds-num\" data-state=\"up\">3</span><span class=\"ds-num\" data-state=\"waypoint\">4</span></div>",
      "css": ".ds-nums{display:flex;gap:12px;padding:8px}.ds-num{width:28px;height:28px;box-sizing:border-box;display:grid;place-items:center;border-radius:50%;background:var(--w-accent,#FFD43B);color:var(--w-on-accent,#11151B);font-family:'Chakra Petch',system-ui,sans-serif;font-weight:700;font-size:14px}.ds-num[data-state=partial]{background:transparent;color:var(--w-accent,#FFD43B);border:2px dashed var(--w-accent,#FFD43B)}.ds-num[data-state=up]{box-shadow:0 0 0 2px var(--w-panel,#0A0D12),0 0 0 4px var(--w-xp,#9B5CF6)}.ds-num[data-state=waypoint]{background:var(--w-sky,#74C0FC)}"
    },
    {
      "name": "Stop Row",
      "kind": "custom",
      "refersTo": "stop-number",
