      "css": ".ds-map{display:flex;gap:16px;padding:14px;background:#24401f;border-radius:8px}.ds-camp{width:26px;height:26px;box-sizing:border-box;display:grid;place-items:center;border-radius:50%;border:2px solid rgba(255,255,255,.9);background:var(--c);color:#11151B;font-family:'Hanken Grotesk',system-ui,sans-serif;font-weight:900;font-size:12px;box-shadow:0 0 0 1.5px #11151B;transition:transform 120ms ease}.ds-camp:hover{transform:scale(1.18)}.ds-camp-active{transform:scale(1.3);box-shadow:0 0 0 3px #11151B,0 0 0 6px #FFD43B}"
